# Payload CMS Environment Variables
# Copy this file to .env and fill in actual values from your secret store

# Database connection (uses per-service user for security isolation)
# Password must be URL-encoded: + → %2B, / → %2F, = → %3D
DATABASE_URL=postgres://payload_user:YOUR_URL_ENCODED_PASSWORD@localhost:5432/payload_db

# Payload secret (generate with: openssl rand -base64 32)
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Server URL for CORS/CSRF (must match your dev server)
NEXT_PUBLIC_SERVER_URL=http://localhost:7773

# Port configuration
PORT=7773

# Payload admin credentials (for onInit hook)
PAYLOAD_ADMIN_EMAIL=admin@example.com
PAYLOAD_ADMIN_PASSWORD=YOUR_SECURE_PASSWORD_HERE

# Vendure sync webhook secret (must match apps/vendure/.env)
VENDURE_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Starlight docs proxy URL (used in next.config.mjs rewrites)
# Local dev: http://localhost:7776 (default fallback if unset)
# Docker: http://starlight:7776 (set in docker-compose.yml)
STARLIGHT_URL=http://localhost:7776

# Vendure Shop API (for product blocks)
NEXT_PUBLIC_VENDURE_API_URL=http://localhost:7774/shop-api

# Authentik OIDC (for auth)
AUTHENTIK_ISSUER=http://localhost:7778/application/o/payload-cms/
AUTHENTIK_CLIENT_ID=YOUR_CLIENT_ID_HERE
AUTHENTIK_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE
AUTH_SECRET=YOUR_AUTH_SECRET_HERE

# Puck AI (get key from puckeditor.com)
PUCK_API_KEY=YOUR_PUCK_API_KEY_HERE

# Puck AI routing. "bridge" routes the in-editor AI chat to the local
# Claude Code bridge (tools/puck-claude-bridge — subscription OAuth, no
# Anthropic API key). Unset or any other value → official Puck Cloud proxy.
# The bridge only works while it runs on the operator machine; never deploy it.
PUCK_AI_MODE=bridge
# From host dev: 127.0.0.1. From the Docker web container this is overridden
# to host.docker.internal in docker/docker-compose.yml.
PUCK_AI_BRIDGE_URL=http://127.0.0.1:8765
# Must match tools/puck-claude-bridge/.env. Generate: openssl rand -hex 32
PUCK_AI_BRIDGE_SECRET=CHANGE_ME_64_HEX_CHARS

# TGP is live (the owner 2026-07-31). Emergency lever only: set to 'on' to put the site
# back behind the holding page without a rebuild. Unset = the live TGP shop.
# TGP_HOLDING=on
