{
  "name": "web",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 7773",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev -p 7773",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "migrate:puck-slots": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/migrate-puck-slots.ts",
    "seed:brand-pages": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed-brand-pages.ts",
    "seed:policies": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed-policy-pages.ts",
    "fix:community-cta": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/point-community-cta.ts",
    "seed:test-course": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed-test-course.ts",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint . --max-warnings=0",
    "lint:adherence": "node scripts/design-adherence.mjs",
    "type-check": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 7773",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.47",
    "@delmaredigital/payload-page-tree": "^0.3.16",
    "@delmaredigital/payload-puck": "^0.6.30",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/email-nodemailer": "^3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/plugin-multi-tenant": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "@puckeditor/core": "^0.21.1",
    "@puckeditor/plugin-ai": "^0.7.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@remotion/cli": "^4.0.415",
    "@remotion/player": "^4.0.415",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@acme-commerce/types": "workspace:*",
    "ai": "6.0.234",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "drizzle-kit": "0.31.7",
    "graphql": "^16.8.1",
    "isomorphic-dompurify": "3.20.0",
    "next": "16.2.11",
    "next-auth": "5.0.0-beta.32",
    "payload": "3.86.0",
    "postcss": "^8.5.22",
    "postcss-load-config": "^6.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "^4.0.415",
    "sharp": "0.35.3",
    "tailwindcss": "^4.1.18",
    "three": "^0.182.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.5.4",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.11",
    "jsdom": "26.1.0",
    "playwright": "1.56.1",
    "playwright-core": "1.56.1",
    "prettier": "^3.4.2",
    "tsx": "4.23.1",
    "typescript": "5.8.2",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "^11"
  }
}
