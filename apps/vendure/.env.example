# Vendure Environment Variables
# Copy this file to .env and fill in actual values from your secret store

# Environment
APP_ENV=dev

# Server Port — serves the API and the React Dashboard at /dashboard.
# (ADMIN_PORT/7775 belonged to the legacy Angular admin, removed 2026-07-31.)
PORT=7774

# Database Settings (uses per-service user for security isolation)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vendure_db
DB_USERNAME=vendure_user
DB_PASSWORD=your_secure_password_here

# Security
COOKIE_SECRET=generate_with_openssl_rand_base64_32
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=generate_with_openssl_rand_base64_32

# Payload Sync Plugin
# Variable name must match: process.env.PAYLOAD_SYNC_URL in plugins/payload-sync/
# Docker override: http://web:7773/api/vendure-sync (see docker-compose.yml line 65)
PAYLOAD_SYNC_URL=http://localhost:7773/api/vendure-sync
VENDURE_WEBHOOK_SECRET=must_match_apps_web_env
