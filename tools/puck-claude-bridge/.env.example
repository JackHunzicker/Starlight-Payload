# Copy to .env (gitignored). The secret must match PUCK_AI_BRIDGE_SECRET in apps/web/.env.
# Generate with: openssl rand -hex 32
PUCK_AI_BRIDGE_SECRET=CHANGE_ME_64_HEX_CHARS

# Optional overrides
# PUCK_AI_BRIDGE_PORT=8765
# PUCK_AI_BRIDGE_MODEL=fable
# PUCK_AI_BRIDGE_EFFORT=medium
# PUCK_AI_BRIDGE_TIMEOUT_MS=300000
# PUCK_AI_BRIDGE_MAX_CONCURRENT=2
# CLAUDE_BIN=C:\Users\example-owner\.local\bin\claude.exe
