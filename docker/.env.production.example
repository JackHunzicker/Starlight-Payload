# Acme Commerce PRODUCTION environment — TEMPLATE for the VPS docker/.env.
# Fresh secret values are MINTED at VPS setup (openssl rand -base64 32) and the
# file lives root-owned chmod 600. Never reuse dev values; never commit this
# filled in. Registry of record: your secret store
# (updated to note "production" per key when minted).
#
# Run production as:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d

# --- Domains (THE NAMECHEAP MAP — the owner input, Phase C §14). One hostname per
#     service; www. variants redirect in the Caddyfile. Parked/alias domains
#     get redirect blocks in docker/caddy/Caddyfile when DNS lands.
TLR_DOMAIN=example.com
TGP_DOMAIN=vertexsupply.example
SNM_DOMAIN=orbitlabs.example
COMMUNITY_DOMAIN=community.example.com
VENDURE_DOMAIN=commerce.example.com
# Redirect-only domains (A/AAAA at this box; Caddy 301s them to the primaries).
# Spelling VERIFIED against live DNS 2026-07-29: it is orbitlabs-alt.example with
# the "i" — "orbitlabs-alt.com" is not a registered domain and was a typo that
# briefly reached this file. Both redirect domains resolve to the VPS.
SNM_REDIRECT_DOMAIN=orbitlabs-alt.example
TGP_REDIRECT_DOMAIN=vertexsupply-alt.example
# BTCPay's public hostname. It is a SEPARATE compose project (docker/btcpay)
# that Caddy fronts, because only one thing may own 80/443. Customers are
# redirected here during checkout, so it must resolve publicly and hold a cert.
PAY_DOMAIN=pay.example.com
# Where Caddy finds that stack. BTCPay publishes on the docker0 gateway only
# (docker/btcpay/.env NOREVERSEPROXY_HTTP_PORT), keeping it off the public
# internet — Docker publishing bypasses UFW, so 0.0.0.0 would expose it.
BTCPAY_UPSTREAM=172.17.0.1:7779
# Subnet Caddy shares with proxied services; Authentik trusts X-Forwarded-*
# only from here.
EDGE_SUBNET=172.28.0.0/24
# Let's Encrypt expiry/problem notices.
ACME_EMAIL=

# --- SMTP: Namecheap Private Email (the owner already owns the inboxes —
#     orbit@orbitlabs.example, info@example.com,
#     info@vertexsupply.example). Transactional sender = the TLR inbox.
#     Server: smtp.example.com, 587 STARTTLS (SMTP_SECURE=false) or 465
#     SSL (SMTP_SECURE=true). Username = the full email address.
#     Namecheap publishes the SPF/DKIM values to add as Namecheap DNS TXT
#     records at cutover. Rehearsal: SMTP_HOST=mailpit SMTP_PORT=1025.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@example.com
SMTP_PASS=
EMAIL_FROM_ADDRESS=info@example.com
# QUOTE any value containing a space. This file is BOTH parsed by compose and
# SOURCED by deploy/vps-migrate.sh; compose strips the quotes, while bash would
# otherwise treat the second word as a command and exit 127 under `set -e`.
EMAIL_FROM_NAME="Acme Commerce"

# --- Puck AI bridge (tailnet address after the VPS joins the tailnet; leave
#     empty to disable the editor AI chat in production).
PUCK_AI_BRIDGE_URL=

# --- PostgreSQL ---
POSTGRES_PASSWORD=
PAYLOAD_DB_PASSWORD=
PAYLOAD_DB_PASSWORD_URLENC=
VENDURE_DB_PASSWORD=
SHARKEY_DB_PASSWORD=

# --- Payload CMS ---
PAYLOAD_SECRET=
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=
# Build strategy decided at rehearsal (deploy/README.md): on-box builds need
# postgres reachable at build time.
WEB_BUILD_DATABASE_URL=

# --- Vendure ---
COOKIE_SECRET=
VENDURE_ADMIN_IDENTIFIER=admin@commerce.example.com
SUPERADMIN_PASSWORD=
VENDURE_WEBHOOK_SECRET=

# --- BTCPay (the VPS BTCPay is the official docker deployment, separate stack;
#     these point Vendure at it). BTCPAY_SERVER_URL is the public https origin
#     (https://$PAY_DOMAIN); BTCPAY_API_KEY must be a LIMITED key scoped to
#     invoice create/view — never the admin key. STORE_ID and API_KEY can only
#     be filled after the mainnet store exists. ---
BTCPAY_SERVER_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=
# BTCPAY_REDIRECT_URL is derived in docker-compose.prod.yml from TLR_DOMAIN.

# --- Paymento (non-custodial multi-coin gateway; app.paymento.io). Key + IPN
#     secret come from the store dashboard once the store exists; the wallet
#     keys it watches must be a DEDICATED account, never the main one (an xpub
#     exposes every derived address). PAYMENTO_REDIRECT_URL is derived in
#     docker-compose.prod.yml from TLR_DOMAIN. ---
PAYMENTO_API_KEY=
PAYMENTO_IPN_SECRET=


# --- Sharkey (rendered into apps/sharkey/.config/default.yml via
#     deploy/render-configs.sh — re-run after changing) ---
SHARKEY_URL=https://community.example.com
SHARKEY_SETUP_PASSWORD=

# --- Also required on the VPS, OUTSIDE this file: apps/web/.env (env_file for
#     the web container; root-owned chmod 600) carrying AUTH_SECRET,
#     PUCK_API_KEY, PUCK_AI_MODE,
#     PUCK_AI_BRIDGE_SECRET, DATABASE_URL, NEXT_PUBLIC_* — see
#     apps/web/.env.example and deploy/README.md.
