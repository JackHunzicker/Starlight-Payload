# BTCPay MAINNET — template for docker/btcpay/.env on the VPS.
# Real values live only in the ignored .env there and in the secrets registry.
#
# NOTE ON THE NETWORK SWITCH: BTCPay names its databases
# btcpayserver${NBITCOIN_NETWORK} / nbxplorer${NBITCOIN_NETWORK}, so flipping
# regtest→mainnet starts from EMPTY BTCPay databases. Regtest stores, invoices
# and wallets do not carry over, and should not — they were play money.

BTCPAY_HOST=pay.example.com
NBITCOIN_NETWORK=mainnet

# Publish on the docker0 gateway ONLY — Caddy owns 80/443 and fronts this with
# TLS. Docker publishing bypasses UFW, so 0.0.0.0 here would expose BTCPay
# directly to the internet. Must match BTCPAY_UPSTREAM in docker/.env.
NOREVERSEPROXY_HTTP_PORT=172.17.0.1:7779

BTCPAY_ROOTPATH=/

# Pruned-node target in MiB (compose.mainnet.yml). 80000 ≈ 80 GB of blocks
# kept. Raise if the box has room; never set below 550 (bitcoind's floor).
BITCOIN_PRUNE_MB=80000

BTCPAY_SSHTRUSTEDFINGERPRINTS=
BTCPAY_SSHKEYFILE=
BTCPAY_SSHAUTHORIZEDKEYS=

# Provisioned at setup; recorded in the secrets registry, never committed.
# The Vendure-facing key must be a LIMITED key (invoice create/view only) —
# never the admin key.
BTCPAY_ADMIN_EMAIL=
BTCPAY_ADMIN_PASSWORD=
BTCPAY_ADMIN_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_VENDURE_API_KEY=
BTCPAY_WEBHOOK_SECRET=
BTCPAY_WEBHOOK_ID=
