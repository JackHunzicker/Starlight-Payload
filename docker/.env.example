# Acme Commerce docker environment — TEMPLATE.
# Copy to docker/.env and fill in. The human-authoritative registry for real
# values is your secret store (gitignored; see the
# Secrets Runbook in docs/20-operations/ before changing any password).
# Production: fresh values are MINTED at VPS setup — never reuse dev values.
#
# Generate secrets with:  openssl rand -base64 32

# --- PostgreSQL (shared container, per-service databases/users) ---
POSTGRES_PASSWORD=
PAYLOAD_DB_PASSWORD=
# URL-encoded twin of PAYLOAD_DB_PASSWORD (base64 chars +, /, = must be %-escaped
# inside connection URLs).
PAYLOAD_DB_PASSWORD_URLENC=
VENDURE_DB_PASSWORD=
SHARKEY_DB_PASSWORD=

# --- Payload CMS ---
PAYLOAD_SECRET=
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=
# Consumed by the BuildKit build secret (docker-compose.yml `secrets:`) for the
# Next.js build-time prerender. Dev builds reach the host-published postgres:
# postgres://payload_user:<PAYLOAD_DB_PASSWORD_URLENC>@host.docker.internal:5432/payload_db
WEB_BUILD_DATABASE_URL=

# --- Vendure ---
COOKIE_SECRET=
VENDURE_ADMIN_IDENTIFIER=admin@commerce.example.com
SUPERADMIN_PASSWORD=
VENDURE_WEBHOOK_SECRET=

# --- BTCPay (leave empty until the BTCPay store exists in this environment) ---
BTCPAY_SERVER_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=
BTCPAY_REDIRECT_URL=

# --- Paymento (leave empty until the Paymento store exists — app.paymento.io.
#     API key + IPN secret come from the store dashboard; the xpub/addresses it
#     watches must be a DEDICATED wallet account, never the main one) ---
PAYMENTO_API_KEY=
PAYMENTO_IPN_SECRET=
PAYMENTO_REDIRECT_URL=


# --- Sharkey (rendered into apps/sharkey/.config/default.yml — run
#     deploy/render-configs.* after changing) ---
# Canonical URL — ONE-WAY once federation is enabled. Dev: tailnet address.
SHARKEY_URL=
# Only consulted while the instance has no admin account.
SHARKEY_SETUP_PASSWORD=
